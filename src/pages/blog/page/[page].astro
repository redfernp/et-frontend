---
import ExactArchiveRoute from '../../../components/ExactArchiveRoute.astro';
import { loadArchiveRoutes } from '../../../lib/archive-route-data.mjs';
export async function getStaticPaths() {
  return (await loadArchiveRoutes()).filter((item) => /^\/blog\/page\/\d+$/.test(item.path))
    .map((archive) => ({ params: { page: String(archive.page) }, props: { archive } }));
}
const { archive } = Astro.props;
---
<ExactArchiveRoute archive={archive} />
