---
import PolicyShell from '../components/PolicyShell.astro';
import { getLegalPageByUri } from '../lib/wpgraphql';
import { latestContentSnapshot } from '../lib/migration-preview.mjs';

const page = await getLegalPageByUri('/terms-conditions');
const snapshot = await latestContentSnapshot();
const record = snapshot?.pages.find((item: { uri: string; seo?: { title?: string; metaDesc?: string } }) => item.uri === '/terms-conditions');
---
<PolicyShell exactPath title="Terms and conditions" kind="Site terms" intro="The existing EveryTip site terms in a clearer reading layout. Bookmaker offer terms remain separate from these site terms." content={page.content} modified={page.modified} seo={{ title: record?.seo?.title, description: record?.seo?.metaDesc }} reviewNote="Preserved from staging WordPress for design review; confirm the wording and links before launch. No revised legal terms have been invented by the frontend." />
