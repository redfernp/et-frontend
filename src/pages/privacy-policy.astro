---
import PolicyShell from '../components/PolicyShell.astro';
import { getLegalPageByUri } from '../lib/wpgraphql';
import { latestContentSnapshot } from '../lib/migration-preview.mjs';

const page = await getLegalPageByUri('/privacy-policy');
const snapshot = await latestContentSnapshot();
const record = snapshot?.pages.find((item: { uri: string; seo?: { title?: string; metaDesc?: string } }) => item.uri === '/privacy-policy');
---
<PolicyShell exactPath title="Privacy notice and cookies" kind="Privacy page" intro="The current EveryTip privacy and cookie wording, made easier to read and navigate." content={page.content} modified={page.modified} seo={{ title: record?.seo?.title, description: record?.seo?.metaDesc }} reviewNote="The existing notice names older email and opt-in providers. It must be updated for the actual Sendfox, ConvertBox, Cloudflare and tracking setup before launch; this preview is not a sign-off of its accuracy." />
