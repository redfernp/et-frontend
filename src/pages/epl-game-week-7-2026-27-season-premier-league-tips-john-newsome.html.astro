---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColumnistProfile from '../components/ColumnistProfile.astro';
import { offlinePreviewProfiles } from '../lib/columnist-profiles.mjs';
import { johnWeek7, johnWeek7Preview, previewJohnWeek7Body } from '../lib/live-john-week7.mjs';
import { previewPublicPaths } from '../lib/preview-public-paths.ts';

const { record, sourceMode, capturedAt } = await johnWeek7Preview();
const body = previewJohnWeek7Body(record);
if (Astro.url.pathname.replace(/\/$/, '') !== johnWeek7.uri) throw new Error('John Week 7 exact URL mismatch');
---
<BaseLayout title={`${record.title} — exact live-content preview`} sidebar withholdSidebarOffers
  publicPage previewOnly verifiedPublicPaths={[...previewPublicPaths, '/english-premier-league-predictions-for-saturday']}
  relatedTopic="football"
  robots="noindex,nofollow" previewMessage="Exact live John Newsome article preview · noindex · historical prices and commercial claims withheld">
  <article class="exact-week7">
    <p class="kicker">Premier League column · local preview</p>
    <h1>{record.title}</h1>
    <ColumnistProfile profile={offlinePreviewProfiles.john} variant="byline" />
    <p class="article-meta">Published <time datetime={record.date.slice(0, 10)}>{record.date.slice(0, 10)}</time> · John Newsome · WordPress post {record.id}</p>
    <p class="article-warning" role="note">Editorial match analysis is shown as a dated record. {body.withheldBlocks} bookmaker, price, promotion or commercial-link blocks are withheld. Remaining links are disabled. No offer, quoted odds or dated selection on this preview is approved as current advice.</p>
    <div class="article-body" set:html={body.html} />
    <ColumnistProfile profile={offlinePreviewProfiles.john} variant="full" archiveHref="/english-premier-league-predictions-for-saturday" />
    <p class="article-source">{sourceMode === 'live-public-rest-read-only' ? 'Read-only live public REST' : 'Dated live public REST snapshot'} captured {capturedAt.slice(0, 10)} · source modified {record.modified.slice(0, 10)} · exact path <code>{johnWeek7.uri}</code> · noindex preview</p>
  </article>
</BaseLayout>
<style>
  .exact-week7{max-width:980px;margin:auto;padding:clamp(20px,3vw,36px);background:#fff}
  .exact-week7 h1{font-size:clamp(30px,4vw,44px);line-height:1.13;color:#183f60}
  .article-meta,.article-source{font-size:12px;color:#627585}
  .article-warning{padding:14px 17px;background:#fff4e9;border-left:4px solid var(--et-orange);font-size:13px;line-height:1.55}
  .article-body{overflow-wrap:anywhere;line-height:1.72}
  .article-body :global(img){max-width:100%;height:auto}
  .article-source{margin-top:30px;border-top:1px solid #dce7ed;padding-top:12px}
  .article-source code{overflow-wrap:anywhere}
  :global(.page-shell.with-sidebar) .exact-week7{max-width:none;padding:0}
</style>
