---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColumnistProfile from '../components/ColumnistProfile.astro';
import { offlinePreviewProfiles } from '../lib/columnist-profiles.mjs';
import { seymourOct3, seymourOct3Preview, previewSeymourOct3Body } from '../lib/live-seymour-oct3.mjs';
import { previewPublicPaths } from '../lib/preview-public-paths.ts';

const { record, sourceMode, capturedAt } = await seymourOct3Preview();
const body = previewSeymourOct3Body(record);
if (Astro.url.pathname.replace(/\/$/, '') !== seymourOct3.uri) throw new Error('Seymour 3 October exact URL mismatch');
---
<BaseLayout title={`${record.title} — exact live-content preview`} sidebar withholdSidebarOffers
  publicPage previewOnly verifiedPublicPaths={[...previewPublicPaths, '/saturday-horse-racing-tips']}
  relatedTopic="racing"
  robots="noindex,nofollow" previewMessage="Exact live Seymour Biz article preview · noindex · dated offer and odds claims withheld">
  <article class="exact-seymour-oct3">
    <p class="kicker">Saturday racing column · local preview</p>
    <h1>{record.title}</h1>
    <ColumnistProfile profile={offlinePreviewProfiles.seymour} variant="byline" />
    <p class="article-meta">Published <time datetime={record.date.slice(0, 10)}>{record.date.slice(0, 10)}</time> · Seymour Biz · WordPress post {record.id}</p>
    <p class="article-warning" role="note">Race analysis is shown as a dated record, not current betting advice. {body.withheldBlocks} bookmaker, offer, odds or commercial-link blocks are withheld. Remaining links are disabled, and the original selections have not been reverified.</p>
    <div class="article-body" set:html={body.html} />
    <ColumnistProfile profile={offlinePreviewProfiles.seymour} variant="full" archiveHref="/saturday-horse-racing-tips" />
    <p class="article-source">{sourceMode === 'live-public-rest-read-only' ? 'Read-only live public REST' : 'Dated live public REST snapshot'} captured {capturedAt.slice(0, 10)} · source modified {record.modified.slice(0, 10)} · exact path <code>{seymourOct3.uri}</code> · noindex preview</p>
  </article>
</BaseLayout>
<style>
  .exact-seymour-oct3{max-width:980px;margin:auto;padding:clamp(20px,3vw,36px);background:#fff}
  .exact-seymour-oct3 h1{font-size:clamp(30px,4vw,44px);line-height:1.13;color:#183f60}
  .article-meta,.article-source{font-size:12px;color:#627585}
  .article-warning{padding:14px 17px;background:#fff4e9;border-left:4px solid var(--et-orange);font-size:13px;line-height:1.55}
  .article-body{overflow-wrap:anywhere;line-height:1.72}
  .article-body :global(img){max-width:100%;height:auto}
  .article-source{margin-top:30px;border-top:1px solid #dce7ed;padding-top:12px}
  .article-source code{overflow-wrap:anywhere}
  :global(.page-shell.with-sidebar) .exact-seymour-oct3{max-width:none;padding:0}
</style>
