---
import ExactArchiveRoute from '../components/ExactArchiveRoute.astro';
import { loadArchiveRoutes } from '../lib/archive-route-data.mjs';
const archive = (await loadArchiveRoutes()).find((item) => item.path === '/betfair-profits');
if (!archive) throw new Error('Missing /betfair-profits crawl route');
---
<ExactArchiveRoute archive={archive} />
