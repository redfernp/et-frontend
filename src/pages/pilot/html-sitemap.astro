---
import BaseLayout from '../../layouts/BaseLayout.astro';
const groups = [
  { id: 'start', title: 'Start here', links: [ { label: 'Home', href: '/pilot/home/' }, { label: 'Free betting tips', href: '/pilot/free-betting-tips/' }, { label: 'Free bets and offers', href: '/pilot/bookie-free-bets-bonus-offers/' }, { label: 'Newsletter', href: '/pilot/daily-newsletter/' } ] },
  { id: 'racing', title: 'Horse racing', links: [ { label: 'Dark Horse value tips', href: '/pilot/value-bet-tips-dark-horses/' }, { label: 'Racecourse directory', href: '/pilot/racecourses/' }, { label: 'Kempton racing tips', href: '/pilot/racecourses/kempton-racing-tips/' }, { label: 'Saturday racing column', href: '/pilot/saturday-horse-racing-tips/' } ] },
  { id: 'football', title: 'Football', links: [ { label: 'Premier League betting tips', href: '/pilot/english-premier-league-betting-tips/' }, { label: 'John Newsome column', href: '/pilot/english-premier-league-predictions-for-saturday/' }, { label: 'Football accumulator guide', href: '/pilot/how-to-win-football-accumulators.html/' } ] },
  { id: 'commercial', title: 'Reviews and guides', links: [ { label: 'Bookmaker reviews', href: '/pilot/bookmaker-reviews/' }, { label: 'Bet365 review', href: '/pilot/bet365-review/' }, { label: 'Betfair Exchange review', href: '/pilot/betfair-exchange-review.html/' }, { label: 'Tipster-service review', href: '/pilot/tipster-service-review/' }, { label: 'Betting guides', href: '/pilot/betting-guides/' }, { label: 'Paid tipster directory', href: '/pilot/winning-football-tipsters/' } ] },
  { id: 'information', title: 'About and policies', links: [ { label: 'About EveryTip', href: '/pilot/about-us/' }, { label: 'Contact', href: '/pilot/we-love-to-hear-from-you/' }, { label: 'Privacy notice', href: '/pilot/privacy-policy/' }, { label: 'Terms and conditions', href: '/pilot/terms-conditions/' }, { label: 'Safer gambling', href: '/pilot/safer-gambling/' } ] },
];
---
<BaseLayout title="HTML sitemap — pilot" wide={true}>
  <article class="sitemap-pilot">
    <nav class="sm-crumb" aria-label="Breadcrumb"><a href="/pilot/home/">EveryTip</a><span aria-hidden="true">›</span><span>Sitemap</span></nav>
    <header class="sm-hero"><p class="kicker">Site navigation · design pilot</p><h1>Explore EveryTip</h1><p>A human-readable route into the main page families, without burying readers in hundreds of dated predictions.</p><div><span>1 October 2026 preview</span><span>Representative pilot routes</span><span>Not an XML sitemap</span></div></header>
    <p class="sm-note"><strong>Publishing rule.</strong> The production HTML sitemap should draw from the same published URL registry as the Astro build. It should exclude redirects, noindex archives, expired offers and private previews as appropriate. This page currently lists representative pilot links, not the full live inventory.</p>
    <nav class="sm-jump" aria-label="Sitemap categories">{groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}</nav>
    <div class="sm-grid">{groups.map((group) => <section id={group.id}><h2>{group.title}</h2><ul>{group.links.map((link) => <li><a href={link.href}>{link.label}<span aria-hidden="true">→</span></a></li>)}</ul></section>)}</div>
    <footer class="sm-footer">The production sitemap will preserve exact legacy canonical paths, including `.html` endings where applicable. 18+ · Gamble responsibly.</footer>
  </article>
</BaseLayout>
<style>
  .sitemap-pilot{color:#273d4e}.sm-crumb{display:flex;gap:8px;margin-bottom:19px;color:#647c8d;font-size:12px}.sm-hero{padding:26px;background:linear-gradient(110deg,#e9f3f9,#fff);border-top:5px solid var(--et-orange)}.sm-hero h1{margin:3px 0 9px}.sm-hero>p:not(.kicker){max-width:690px;font-size:17px}.sm-hero>div{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.sm-hero span{padding:6px 9px;background:#fff;color:#52738a;font-size:11px;font-weight:800}.sm-note{margin:15px 0;padding:14px 16px;background:#fff4e8;border-left:4px solid var(--et-orange);font-size:12px}.sm-jump{display:flex;flex-wrap:wrap;gap:7px;margin:22px 0}.sm-jump a{padding:7px 10px;background:#eaf3f9;text-decoration:none;font-size:12px;font-weight:800}.sm-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.sm-grid section{scroll-margin-top:20px;padding:18px;background:#fff;border:1px solid #d9e6ec;border-top:4px solid var(--et-blue)}.sm-grid h2{margin:0 0 12px;font-size:20px}.sm-grid ul{list-style:none;padding:0;margin:0}.sm-grid li{border-top:1px solid #e5edf1}.sm-grid li:first-child{border-top:0}.sm-grid a{display:flex;justify-content:space-between;gap:10px;padding:8px 0;text-decoration:none;font-size:13px;font-weight:750}.sm-grid a:hover{text-decoration:underline}.sm-footer{margin-top:28px;padding:14px 0;border-top:1px solid #d9e6ec;color:#627c8e;font-size:11px}@media(max-width:650px){.sm-hero{padding:20px 15px}.sm-hero>p:not(.kicker){font-size:15px}.sm-grid{grid-template-columns:1fr}}
</style>
