---
import EditorialArchive from '../../../../components/EditorialArchive.astro';
import { editorialArchives, editorialArchivePageCount } from '../../../../lib/editorial-archives';

export function getStaticPaths() {
  return Array.from({ length: editorialArchivePageCount(editorialArchives['betting-guides']) - 1 }, (_, index) => ({ params: { page: String(index + 2) }, props: { page: index + 2 } }));
}
const { page } = Astro.props;
---
<EditorialArchive data={editorialArchives['betting-guides']} page={page} />
