---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Fictional fixtures illustrate the imported-data component only.
const markets = [
  { id: 'one-x-two', title: '1X2 match predictions', note: 'Home win, draw or away win', picks: [
    { time: '14:00', league: 'Example league', home: 'Sample Town', away: 'Demo United', pick: 'Home win', price: '—' },
    { time: '16:30', league: 'Example league', home: 'North Example', away: 'South Example', pick: 'Draw', price: '—' },
  ] },
  { id: 'goals', title: 'Goals markets', note: 'Over/under and both teams to score', picks: [
    { time: '17:45', league: 'Sample competition', home: 'Demo City', away: 'Example Rovers', pick: 'Over 2.5', price: '—' },
    { time: '19:00', league: 'Sample competition', home: 'West Sample', away: 'East Demo', pick: 'Both teams to score', price: '—' },
  ] },
];
---
<BaseLayout title="Football betting tips — sport hub pilot" sidebar={true} relatedTopic="football">
  <article class="sport-hub">
    <nav class="sport-breadcrumb" aria-label="Breadcrumb"><a href="/pilot/home/">EveryTip</a><span aria-hidden="true">›</span><a href="/pilot/free-betting-tips/">Free tips</a><span aria-hidden="true">›</span><span>Football</span></nav>
    <header class="sport-hero"><p class="kicker">Sport tips hub · design pilot</p><h1>Football betting tips</h1><p>Scan today’s selections by market, read our football columns, and understand how the predictions are produced. The published version will be populated from the canonical daily import, not copied tables in WordPress.</p><div class="sport-snapshot"><span>Illustrative fixtures only</span><span>Last feed update: import timestamp slot</span></div></header>
    <aside class="sport-alert"><strong>No live predictions in this preview.</strong><p>All teams, competitions and picks below are fictional. This page tests the market grouping and mobile reading experience; it does not provide betting advice.</p></aside>
    <nav class="sport-jump" aria-label="Football tip markets"><strong>Jump to</strong>{markets.map((market) => <a href={`#${market.id}`}>{market.title}</a>)}<a href="#columns">Expert previews</a><a href="#history">Previous tips</a></nav>
    <section class="sport-overview"><h2>Today’s football selections</h2><p>Each market comes from a structured selection record with fixture ID, kickoff time and timezone, league, market, prediction, price snapshot and import run. A change after publication should be logged as a correction rather than silently replacing the original.</p></section>
    {markets.map((market) => <section id={market.id} class="sport-market"><div class="sport-section-head"><div><p class="kicker">Today’s list</p><h2>{market.title}</h2><p>{market.note}</p></div><span>{market.picks.length} sample picks</span></div><div class="sport-table-wrap"><table><thead><tr><th scope="col">Time</th><th scope="col">League</th><th scope="col">Fixture</th><th scope="col">Tip</th><th scope="col">Odds</th></tr></thead><tbody>{market.picks.map((pick) => <tr><td>{pick.time}</td><td>{pick.league}</td><td>{pick.home} v {pick.away}</td><td><strong>{pick.pick}</strong></td><td>{pick.price}</td></tr>)}</tbody></table></div><div class="sport-mobile-picks">{market.picks.map((pick) => <article><div><span>{pick.time} · {pick.league}</span><strong>{pick.home} v {pick.away}</strong></div><div><span>Prediction</span><strong>{pick.pick}</strong></div><small>Price and bookmaker source will appear after the import is connected.</small></article>)}</div></section>)}
    <section id="columns" class="sport-columns"><div class="sport-section-head"><div><p class="kicker">Human analysis</p><h2>Expert football previews</h2><p>Automated tables sit alongside authored columns, not in place of them.</p></div></div><a href="/pilot/english-premier-league-predictions-for-saturday/"><strong>John Newsome’s Premier League predictions</strong><span>Weekly match-by-match analysis →</span></a><a href="/pilot/free-betting-tips/"><strong>Browse all free tips</strong><span>Other markets and sports →</span></a></section>
    <section id="history" class="sport-history"><p class="kicker">Transparent archive</p><h2>Previous selections</h2><details><summary>Show an earlier day</summary><p>A dated, paginated archive of the exact published selections can sit here once the import history is retained. Results are intentionally not part of this first design pass.</p></details></section>
    <section class="sport-editorial"><h2>How to read these predictions</h2><p>Eric can edit the market explanations, responsible-betting guidance and relevant internal links in WordPress. The selection table itself comes from the structured feed. This separation prevents a builder module or pasted HTML table from becoming a second, inconsistent source of truth.</p></section>
    <footer class="sport-footer">Fictional selections only. Published tips require a fresh import, time-zone check and editorial QA. 18+ · Gamble responsibly.</footer>
  </article>
</BaseLayout>
<style>
  .sport-hub{color:#263a4c}.sport-breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;color:#6a7b89;font-size:12px}.sport-hero{padding:25px;background:linear-gradient(105deg,#e8f2f9,#f9fbfc);border-top:5px solid var(--et-orange)}.sport-hero h1{margin:3px 0 10px}.sport-hero>p:not(.kicker){max-width:740px;font-size:16px}.sport-snapshot{display:flex;flex-wrap:wrap;gap:8px;margin-top:17px}.sport-snapshot span{padding:7px 10px;background:#fff;color:#526b7d;font-size:11px;font-weight:800}.sport-alert{margin:15px 0;padding:13px 17px;background:#fff3e9;border-left:4px solid var(--et-orange);font-size:12px}.sport-alert p{margin:3px 0 0}.sport-jump{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:11px 0 17px;border-bottom:1px solid #dce5eb}.sport-jump strong{font-size:12px}.sport-jump a{padding:7px 10px;background:#e9f3fa;font-size:12px;font-weight:800;text-decoration:none}.sport-overview,.sport-market,.sport-columns,.sport-history,.sport-editorial{margin-top:32px;scroll-margin-top:20px}.sport-overview h2,.sport-section-head h2,.sport-history h2,.sport-editorial h2{margin:0 0 8px;font-size:25px}.sport-overview p,.sport-editorial p{max-width:740px}.sport-section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:13px}.sport-section-head .kicker{margin:0}.sport-section-head p:last-child{margin:0;color:#607485;font-size:13px}.sport-section-head>span{font-size:11px;color:#70818c;white-space:nowrap}.sport-table-wrap{overflow:auto}.sport-table-wrap table{min-width:520px}.sport-table-wrap th{background:#1b4b70}.sport-table-wrap td{font-size:12px}.sport-table-wrap td strong{color:#1b5e93}.sport-mobile-picks{display:none}.sport-columns{display:grid;gap:9px}.sport-columns a{display:flex;justify-content:space-between;gap:14px;padding:14px;background:#ecf4f9;text-decoration:none}.sport-columns a span{font-size:12px}.sport-history details{border:1px solid #d9e5ed}.sport-history summary{padding:13px;background:#edf5fa;cursor:pointer;font-weight:800;color:#1d5d8e}.sport-history details p{padding:0 13px;font-size:13px}.sport-footer{margin-top:35px;border-top:1px solid #dce5eb;padding-top:14px;color:#647786;font-size:11px}@media(max-width:600px){.sport-hero{padding:18px 15px}.sport-hero>p:not(.kicker){font-size:14px}.sport-section-head{display:block}.sport-section-head>span{display:block;margin-top:7px}.sport-table-wrap{display:none}.sport-mobile-picks{display:grid;gap:9px}.sport-mobile-picks article{padding:12px;border:1px solid #d8e6ee;border-left:4px solid var(--et-blue)}.sport-mobile-picks article div{display:grid;gap:2px;margin-bottom:8px}.sport-mobile-picks article div span{color:#5c7384;font-size:11px}.sport-mobile-picks article strong{font-size:14px}.sport-mobile-picks article small{display:block;padding-top:8px;border-top:1px solid #e3ebef;color:#6b7d88}.sport-columns a{display:grid}.sport-overview h2,.sport-section-head h2,.sport-history h2,.sport-editorial h2{font-size:22px}}
</style>
