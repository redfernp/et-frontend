---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Newsletter thank-you — pilot" wide={true}>
  <article class="thank-you"><p class="kicker">Subscription state · design pilot</p><div class="thank-icon" aria-hidden="true">✓</div><h1>Check your inbox</h1><p class="thank-lede">This is a sample confirmation page, not evidence that an email was submitted. The final wording depends on the actual ConvertBox and Sendfox opt-in flow, including whether double confirmation is enabled.</p><div class="thank-next"><h2>While you’re here</h2><a href="/pilot/free-betting-tips/">Browse free betting tips →</a><a href="/pilot/saturday-horse-racing-tips/">Read Seymour’s racing column →</a><a href="/pilot/english-premier-league-predictions-for-saturday/">Read John’s football column →</a></div><p class="thank-note">No email address, tracking token or personal preference is rendered into this preview URL. 18+ · Gamble responsibly.</p></article>
</BaseLayout>
<style>.thank-you{max-width:750px;margin:25px auto 45px;text-align:center}.thank-icon{display:grid;place-items:center;width:70px;height:70px;margin:14px auto;border-radius:50%;background:#d9edf7;color:#1d6298;font-size:37px;font-weight:900}.thank-you h1{margin:8px 0 13px}.thank-lede{font-size:17px;color:#536d7d}.thank-next{margin:32px auto;padding:22px;background:#eef5fa;text-align:left;border-top:4px solid var(--et-orange)}.thank-next h2{margin:0 0 13px}.thank-next a{display:block;padding:10px 0;border-top:1px solid #dce7ec;font-weight:800}.thank-note{margin-top:28px;font-size:12px;color:#6a7b87}</style>
