---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Layout fixtures only. The live page contains expired promotions; do not reuse them.
const groups = [
  { id: 'today', title: "Today's checked offers", intro: 'Time-limited promotions that have passed an editor check today.', items: [
    { brand: 'Betfred', type: 'Race-day promotion', label: 'Verified racing offer headline', eligibility: 'Existing customers', date: 'Check date from ACF', accent: '#0f488f' },
    { brand: 'bet365', type: 'Football event', label: 'Verified football offer headline', eligibility: 'Eligibility from ACF', date: 'Check date from ACF', accent: '#147653' },
  ] },
  { id: 'racing', title: 'Horse racing offers', intro: 'Extra places, race-day rewards and other current racing promotions.', items: [
    { brand: '10Bet', type: 'Ongoing racing', label: 'Approved offer headline', eligibility: 'Existing customers', date: 'Check date from ACF', accent: '#0b447f' },
  ] },
  { id: 'football', title: 'Football offers', intro: 'Match and tournament promotions with a dated end or review date.', items: [
    { brand: 'QuinnBet', type: 'Event promotion', label: 'Approved offer headline', eligibility: 'Eligibility from ACF', date: 'Check date from ACF', accent: '#20242b' },
  ] },
];
---
<BaseLayout title="Latest betting offers — index pilot" wide={true}>
  <article class="latest-offers">
    <nav class="latest-breadcrumb" aria-label="Breadcrumb"><a href="/pilot/home/">EveryTip</a><span aria-hidden="true">›</span><span>Latest offers</span></nav>
    <header class="latest-hero"><p class="kicker">Offer index · design pilot</p><h1>New betting offers for existing customers</h1><p>A home for genuine new and ongoing promotions that Eric can turn into useful event-led stories—not a static list of old welcome bonuses.</p><div class="latest-hero-tags"><span>Today</span><span>Horse racing</span><span>Football</span></div></header>
    <aside class="latest-caution"><strong>Preview data only</strong><p>The live page currently contains some dated promotions. None have been copied into this pilot as active offers. Cards below show the intended fields and states; each published card must have approved terms, eligibility, source and expiry or re-check date from its ACF record.</p></aside>
    <nav class="latest-jump" aria-label="Offer categories">{groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}</nav>
    {groups.map((group) => <section class="latest-group" id={group.id}><div class="latest-group-head"><div><p class="kicker">Current promotions</p><h2>{group.title}</h2><p>{group.intro}</p></div><span>{group.items.length} design {group.items.length === 1 ? 'card' : 'cards'}</span></div><div class="latest-grid">{group.items.map((item) => <article class="latest-card" style={`--latest-accent:${item.accent}`}><div class="latest-card-top"><strong>{item.brand}</strong><span>{item.type}</span></div><h3>{item.label}</h3><dl><div><dt>Who can use it</dt><dd>{item.eligibility}</dd></div><div><dt>Last checked</dt><dd>{item.date}</dd></div></dl><p class="latest-terms">Approved compact terms appear here, including the key qualifying action, restrictions and end date. A full-terms disclosure is linked to the central offer record.</p><span class="latest-disabled" aria-label="Offer link disabled in template preview">Offer preview</span></article>)}</div></section>)}
    <section class="latest-story"><div><p class="kicker">Newsletter-ready stories</p><h2>Give each offer a reason to read</h2><p>Eric can write an original story around a major football match or racing festival, then attach the relevant offer record. That story can lead a newsletter email without repeating the same welcome promotion.</p></div><div class="latest-story-example"><strong>Story module</strong><span>Event or fixture hook</span><span>What’s new for readers</span><span>Linked, approved offer</span><span>Publish and expiry dates</span></div></section>
    <footer class="latest-footer">18+ · Gamble responsibly. This pilot has no active promotions or outbound offer links. Expired or unverified records should not render as live offers.</footer>
  </article>
</BaseLayout>
<style>
  .latest-offers{padding:4px 14px 32px}.latest-breadcrumb{display:flex;gap:8px;color:#687a88;font-size:12px;margin-bottom:20px}.latest-hero{padding:28px;background:linear-gradient(105deg,#e5f1f9,#f5f9fc);border-top:5px solid var(--et-orange)}.latest-hero h1{max-width:770px;margin:3px 0 13px}.latest-hero>p:not(.kicker){font-size:17px;max-width:780px}.latest-hero-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.latest-hero-tags span{padding:7px 12px;background:white;border:1px solid #cbdde9;color:#315d7c;font-size:12px;font-weight:800}.latest-caution{margin:16px 0;padding:15px 19px;background:#fff3e9;border-left:4px solid var(--et-orange);font-size:13px}.latest-caution p{margin:5px 0 0}.latest-jump{display:flex;flex-wrap:wrap;gap:10px;padding:8px 0 20px;border-bottom:1px solid #dde6ec}.latest-jump a{padding:9px 12px;background:#e9f2f8;text-decoration:none;font-weight:800;font-size:13px}.latest-group{margin-top:39px;scroll-margin-top:18px}.latest-group-head{display:flex;justify-content:space-between;gap:15px;align-items:end;margin-bottom:17px}.latest-group-head .kicker{margin:0}.latest-group-head h2{margin:3px 0 5px;font-size:28px}.latest-group-head p:last-child{margin:0;color:#607484}.latest-group-head>span{font-size:11px;color:#677886;white-space:nowrap}.latest-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.latest-card{display:flex;flex-direction:column;padding:20px;border:1px solid #d9e4eb;border-top:5px solid var(--latest-accent);box-shadow:0 3px 10px #163f5910}.latest-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.latest-card-top strong{padding:5px 10px;background:var(--latest-accent);color:#fff;font-size:13px}.latest-card-top span{color:#a6530b;text-transform:uppercase;font-size:11px;font-weight:800}.latest-card h3{margin:14px 0 13px;font-size:21px;color:#1b4d74}.latest-card dl{margin:0}.latest-card dl div{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #e3e9ed;padding:8px 0;font-size:12px}.latest-card dt{color:#627584}.latest-card dd{margin:0;font-weight:800;text-align:right}.latest-terms{margin:10px 0 15px;padding:10px;background:#f1f6f8;color:#526b7d;font-size:12px}.latest-disabled{display:block;width:max-content;margin-top:auto;padding:10px 17px;background:var(--et-commercial);border-radius:4px;color:#fff;font-size:12px;font-weight:900;cursor:not-allowed}.latest-story{display:grid;grid-template-columns:1.4fr .6fr;gap:30px;margin-top:45px;padding:25px;background:#e7f1f8;border-left:4px solid var(--et-blue)}.latest-story h2{margin:4px 0 9px}.latest-story-example{display:grid;gap:5px;padding:18px;background:#fff}.latest-story-example span{font-size:12px;border-bottom:1px solid #e1e8ed;padding:5px}.latest-footer{margin-top:40px;border-top:1px solid #dce6eb;padding-top:15px;color:#607484;font-size:12px}@media(max-width:700px){.latest-grid,.latest-story{grid-template-columns:1fr}.latest-group-head{display:block}.latest-group-head>span{display:block;margin-top:7px}}@media(max-width:600px){.latest-offers{padding:0 0 25px}.latest-hero{padding:19px 16px}.latest-hero>p:not(.kicker){font-size:15px}.latest-group-head h2{font-size:24px}.latest-card{padding:15px}}
</style>
