---
import EditorialArchive from '../../../../../components/EditorialArchive.astro';
import { editorialArchives, editorialArchivePageCount } from '../../../../../lib/editorial-archives';

export function getStaticPaths() {
  return Array.from({ length: editorialArchivePageCount(editorialArchives['author/jnewsome']) - 1 }, (_, index) => ({ params: { page: String(index + 2) }, props: { page: index + 2 } }));
}
const { page } = Astro.props;
---
<EditorialArchive data={editorialArchives['author/jnewsome']} page={page} />
