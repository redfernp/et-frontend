---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LaunchHome from '../../components/launch/LaunchHome.astro';
import LaunchFreeTips from '../../components/launch/LaunchFreeTips.astro';
import LaunchFreeBets from '../../components/launch/LaunchFreeBets.astro';
import LaunchBet365Review from '../../components/launch/LaunchBet365Review.astro';
import LaunchColumnArchive from '../../components/launch/LaunchColumnArchive.astro';
import ColumnistProfile from '../../components/ColumnistProfile.astro';
import { launchContent, robotsFor, endpoint } from '../../lib/launch-content.mjs';
import { launchOfferLineup } from '../../lib/launch-offers.mjs';
import { launchHtml } from '../../lib/builder-cleanup.mjs';
import { rebuildRankedCards, fillEmptyLinkCells } from '../../lib/ranked-cards.mjs';
import { columnistKeyForUri, legacyColumnistPortraitPaths } from '../../lib/columnist-profiles.mjs';
import { canonicalFor, articleCategory, columnistArchives, launchColumnists, isGuide, withHeadingIds } from '../../lib/launch-templates.mjs';

export async function getStaticPaths() {
  const records = await launchContent();
  const paths = records.map(record => record.uri);
  return records.map(record => ({
    params: { path: record.uri === '/' ? undefined : record.uri.replace(/^\//, '').replace(/\/$/, '') },
    props: { record, paths, records },
  }));
}
const { record, paths, records } = Astro.props;
const offers = launchOfferLineup();
const seo = {
  title: record.seo?.title || record.title,
  description: record.seo?.metaDesc || '',
  // Canonicals always name the public site, whichever WordPress host the build reads.
  canonical: canonicalFor(record),
  robots: robotsFor(record),
};
const isHome = record.uri === '/';
const archiveColumnist = record.posts?.length ? Object.keys(columnistArchives).find((key) => columnistArchives[key] === record.archiveBase) : null;
const columnist = columnistKeyForUri(record.uri);
const profile = columnist ? (await launchColumnists())[columnist] : null;
const category = articleCategory(record);
let body = record.content ? fillEmptyLinkCells(rebuildRankedCards(launchHtml(record.content, endpoint))) : '';
// Columnist posts carry an old portrait banner that the author box replaces.
if (columnist) for (const path of legacyColumnistPortraitPaths[columnist]) {
  body = body.replace(new RegExp(`<img[^>]*${path.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}[^>]*>`, 'g'), '');
}
const guide = isGuide(record) ? withHeadingIds(body) : null;
if (guide) body = guide.html;
// Tip-table pages need the full width for their seven columns.
const hasTipTable = /ninja_table|ninja-table|footable/i.test(record.content ?? '')
  // Comparison and award pages built around tables use the full width too.
  || (record.kind === 'pages' && /<table/i.test(record.content ?? ''));
const published = record.date?.slice(0, 10);
const modified = record.modified?.slice(0, 10);
const formatDate = (value) => value ? new Date(`${value}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
{isHome ? <LaunchHome record={record} records={records} paths={paths} offers={offers} seo={seo} /> :
 record.uri === '/bookie-free-bets-bonus-offers' ? <LaunchFreeBets record={record} paths={paths} offers={offers} seo={seo} /> :
 archiveColumnist ? <LaunchColumnArchive record={record} records={records} paths={paths} offers={offers} seo={seo} columnist={archiveColumnist} /> :
 record.uri === '/bet365-review' ? <LaunchBet365Review record={record} paths={paths} offers={offers} seo={seo} /> :
 record.uri === '/free-betting-tips' ? <LaunchFreeTips record={record} records={records} paths={paths} offers={offers} seo={seo} /> :
guide ? <BaseLayout title={record.title} wide={true} publicPage={true} seo={seo} verifiedPublicPaths={paths} offers={offers}>
  <article class="paypal-guide integrated-roundup">
    <nav class="paypal-breadcrumb" aria-label="Breadcrumb"><a href="/">EveryTip</a><span aria-hidden="true">›</span>{paths.includes('/betting-guides') ? <a href="/betting-guides">Betting guides</a> : <span>Betting guides</span>}</nav>
    <header class="paypal-hero">
      <div class="paypal-hero-copy">
        <p class="kicker">Betting guide</p>
        <h1 set:html={record.title} />
        {seo.description && <p class="paypal-deck">{seo.description}</p>}
        <p class="paypal-byline">By the EveryTip team · Updated {formatDate(modified || published)}</p>
      </div>
    </header>
    <div class="paypal-disclosure"><strong>#Ad · How this guide earns money</strong><p>EveryTip may receive a commission if you sign up through a bookmaker link in this guide. 18+ · T&amp;Cs apply · Please gamble responsibly.</p></div>
    {guide.toc.length > 1 && <nav class="paypal-toc" aria-label="On this guide"><strong>On this page</strong>{guide.toc.map((item) => <a href={item.href}>{item.label}</a>)}</nav>}
    <div class="exact-preview-body cms-content guide-body" set:html={body} />
  </article>
</BaseLayout> :
<BaseLayout title={record.title} publicPage={true} seo={seo} verifiedPublicPaths={paths} sidebar={!hasTipTable} wide={hasTipTable} offers={offers}>
  <article class="exact-preview launch-article">
    {category ? <p class="kicker"><a href={category.href}>{category.label}</a></p> : null}
    <h1 set:html={record.title} />
    {profile && <ColumnistProfile profile={profile} variant="byline" archiveHref={columnistArchives[columnist]} />}
    {record.kind === 'posts' && published && <p class="exact-preview-meta">
      {profile ? `By ${profile.name} · ` : ''}Published {formatDate(published)}{modified && modified !== published ? ` · Updated ${formatDate(modified)}` : ''}
    </p>}
    {body && <div class="exact-preview-body cms-content" set:html={body} />}
    {record.posts?.length > 0 && <>
      <ol class="archive-posts">
        {record.posts.map(post => <li><a href={post.uri} set:html={post.title} /><time datetime={post.date}>{formatDate(post.date.slice(0, 10))}</time></li>)}
      </ol>
      <nav class="archive-pager" aria-label="Archive pages">
        {record.page > 1 && <a rel="prev" href={record.page === 2 ? record.archiveBase : `${record.archiveBase}/page/${record.page-1}`}>← Newer</a>}
        <span>Page {record.page} of {record.pageCount}</span>
        {record.page < record.pageCount && <a rel="next" href={`${record.archiveBase}/page/${record.page+1}`}>Older →</a>}
      </nav>
    </>}
    {profile && <ColumnistProfile profile={profile} variant="full" archiveHref={columnistArchives[columnist]} />}
    <p class="exact-preview-source">18+ · Please gamble responsibly · <a href="https://www.begambleaware.org/" rel="noopener">BeGambleAware.org</a></p>
  </article>
</BaseLayout>}
<style>
  .exact-preview{margin:auto;max-width:980px;padding:32px;background:#fff}
  .exact-preview .kicker{margin:0 0 6px;font-weight:800;color:#a84c00}
  .exact-preview .kicker a{color:inherit;text-decoration:none}
  .exact-preview-meta,.exact-preview-source{color:#60717e;font-size:12px}
  .exact-preview-body{line-height:1.7;overflow-wrap:anywhere}
  .exact-preview-source{margin-top:35px;border-top:1px solid #dfe7ed;padding-top:12px}
  :global(.page-shell.with-sidebar) .exact-preview{max-width:none;padding:0}
  @media(max-width:600px){.exact-preview{padding:20px}}
  .launch-article{min-width:0}
  .cms-content :global(table th){background:#1d5f94;color:#fff;text-align:left}
  .cms-content :global(table tr:nth-child(even) td){background:#f3f8fb}
  .cms-content :global(table td:first-child),.cms-content :global(table th:first-child){white-space:nowrap}
  @media(max-width:620px){
    .cms-content :global(table:has(th:nth-child(7)) :is(th,td):is(:nth-child(4),:nth-child(5),:nth-child(6))){display:none}
  }
  .guide-body{max-width:none;margin-top:28px}
  .cms-content{max-width:100%;line-height:1.72;overflow-wrap:anywhere;color:#263849}
  .cms-content :global(h2){margin:30px 0 10px;font-size:25px;color:#183f60}
  .cms-content :global(h3){margin:24px 0 8px;color:#183f60}
  .cms-content :global(p){max-width:770px}
  .cms-content :global(img){max-width:100%;height:auto}
  .cms-content :global(table){display:table;width:100%;max-width:100%;border-collapse:collapse}
  @media(max-width:720px){.cms-content :global(table){display:block;overflow-x:auto}}
  .cms-content :global(th),.cms-content :global(td){padding:7px 9px;border:1px solid #dce7ed}
  .cms-content :global(iframe){max-width:100%}
  .cms-content :global(figure){max-width:100%;margin:1rem 0}
  .cms-content :global(.offer-slot){margin:32px 0;padding:18px 20px;border:1px solid #d5e2ea;border-left:5px solid var(--et-orange);background:#fff}
  .cms-content :global(.offer-slot h2){margin:.25rem 0 .6rem;font-size:21px}
  .cms-content :global(.offer-slot p){font-size:13px}
  .cms-content :global(.offer-bookmaker){font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#a74a04;margin:0}
  .cms-content :global(.offer-slot a){display:inline-block;padding:10px 16px;border-radius:4px;background:var(--et-commercial);color:#fff;font-weight:900;text-decoration:none}
  .archive-posts{list-style:none;padding:0;margin:24px 0}
  .archive-posts li{padding:13px 0;border-top:1px solid #dce7ed}
  .archive-posts a{font-weight:800;font-size:17px;text-decoration:none}
  .archive-posts time{display:block;font-size:12px;color:#627585;margin-top:3px}
  .archive-pager{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:2rem 0;font-weight:700}
</style>
