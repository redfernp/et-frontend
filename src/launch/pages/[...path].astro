---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { launchContent, robotsFor, endpoint } from '../../lib/launch-content.mjs';
import { launchHtml } from '../../lib/builder-cleanup.mjs';

export async function getStaticPaths() {
  const records = await launchContent();
  const paths = records.map(record => record.uri);
  return records.map(record => ({
    params: { path: record.uri === '/' ? undefined : record.uri.replace(/^\//, '').replace(/\/$/, '') },
    props: { record, paths },
  }));
}
const { record, paths } = Astro.props;
const seo = {
  title: record.seo?.title || record.title,
  description: record.seo?.metaDesc || '',
  canonical: record.seo?.canonical || null,
  robots: robotsFor(record),
};
---
<BaseLayout title={record.title} publicPage={true} seo={seo} verifiedPublicPaths={paths}>
  <article class="cms-content">
    <h1 set:html={record.title} />
    {record.content && <div set:html={launchHtml(record.content, endpoint)} />}
    {record.posts?.length > 0 && <>
      <ol class="archive-posts">
        {record.posts.map(post => <li><a href={post.uri} set:html={post.title} /><time datetime={post.date}>{post.date.slice(0,10)}</time></li>)}
      </ol>
      <nav aria-label="Archive pages">
        {record.page > 1 && <a rel="prev" href={record.page === 2 ? record.archiveBase : `${record.archiveBase}/page/${record.page-1}`}>Previous</a>}
        <span>Page {record.page} of {record.pageCount}</span>
        {record.page < record.pageCount && <a rel="next" href={`${record.archiveBase}/page/${record.page+1}`}>Next</a>}
      </nav>
    </>}
  </article>
</BaseLayout>
<style>
  .cms-content{max-width:100%;line-height:1.7;overflow-wrap:anywhere}
  .cms-content :global(img){max-width:100%;height:auto}
  .cms-content :global(table){display:block;width:100%;min-width:0;max-width:100%;overflow-x:auto}
  .cms-content :global(iframe){max-width:100%}
  .cms-content :global(figure){max-width:100%;margin:1rem 0}
  .cms-content :global(.offer-slot){margin:1.5rem 0;padding:1.25rem;border:1px solid #d8e2dc;border-left:4px solid #176b3b;border-radius:.5rem;background:#f5faf7}
  .cms-content :global(.offer-slot h2){margin:.25rem 0 .75rem}
  .cms-content :global(.offer-bookmaker){font-weight:700;text-transform:capitalize;margin:0}
  .cms-content :global(.offer-slot a){display:inline-block;padding:.6rem 1rem;background:#176b3b;color:#fff;border-radius:.25rem;font-weight:700}
  .archive-posts{padding-left:1.5rem}.archive-posts li{padding:.75rem 0}.archive-posts time{display:block;font-size:.85rem;color:#555}
  nav{display:flex;gap:1rem;flex-wrap:wrap;margin:2rem 0}
</style>
