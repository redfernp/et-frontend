---
// Site icons for every page head. Files live in public/ and are made from the
// WordPress site icon (cropped-ET.png, 512x512). Google needs a square icon at a
// multiple of 48px, linked from the homepage, so keep this in every template's <head>.
---
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<meta name="msapplication-TileImage" content="/icon-512.png" />
