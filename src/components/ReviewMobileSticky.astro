---
interface Props { bookmaker: string; offerHref?: string; ctaLabel?: string }
const { bookmaker, offerHref, ctaLabel = 'View offer' } = Astro.props;
---
<aside class="review-mobile-sticky" data-review-mobile-sticky aria-label={`${bookmaker} offer`} hidden>
  <div class="sticky-copy"><strong>{bookmaker}</strong><span>New-customer offer</span></div>
  {offerHref
    ? <a class="sticky-cta" href={offerHref} rel="sponsored nofollow">{ctaLabel}</a>
    : <span class="sticky-cta sticky-disabled" aria-label="Offer link disabled in template preview">Offer preview</span>}
  <button class="sticky-dismiss" type="button" aria-label="Dismiss offer bar" data-review-sticky-dismiss>×</button>
  <p class="sticky-disclosure">#Ad · 18+ · Eligibility and terms apply. <a href="#review-offer">Read offer details</a></p>
</aside>
<script>
  const bar = document.querySelector<HTMLElement>('[data-review-mobile-sticky]');
  const offer = document.querySelector<HTMLElement>('#review-offer');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const dismiss = bar?.querySelector<HTMLButtonElement>('[data-review-sticky-dismiss]');
  let dismissed = false;
  let scheduled = false;

  function update() {
    if (!bar || !offer || !footer) return;
    const mobile = window.matchMedia('(max-width: 600px)').matches;
    const pastOffer = offer.getBoundingClientRect().bottom < 0;
    const beforeFooter = footer.getBoundingClientRect().top > window.innerHeight;
    bar.hidden = !(mobile && pastOffer && beforeFooter && !dismissed);
  }

  function scheduleUpdate() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => { scheduled = false; update(); });
  }

  dismiss?.addEventListener('click', () => { dismissed = true; update(); });
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', scheduleUpdate);
  window.addEventListener('pageshow', scheduleUpdate);
  update();
</script>
<style>
  .review-mobile-sticky{display:none}
  @media(max-width:600px){
    .review-mobile-sticky{position:fixed;inset:auto 0 0;z-index:50;display:grid;grid-template-columns:minmax(0,1fr) auto 24px;align-items:center;gap:5px 10px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:#fff;border-top:4px solid #1d5b32;box-shadow:0 -5px 22px #09201838;color:#263748}
    .review-mobile-sticky[hidden]{display:none}
    .sticky-copy{display:grid;min-width:0;line-height:1.15}
    .sticky-copy strong{font-size:14px;color:#164b2b}
    .sticky-copy span{font-size:11px;color:#61717e}
    .sticky-cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:8px 13px;border-radius:5px;background:var(--et-commercial);color:#fff;font-size:12px;font-weight:800;text-transform:uppercase;text-decoration:none;white-space:nowrap}
    .sticky-cta:hover{color:#fff;text-decoration:underline}
    .sticky-disabled{cursor:not-allowed}
    .sticky-dismiss{align-self:start;padding:0;border:0;background:transparent;color:#5f6f78;font-size:23px;line-height:1;cursor:pointer}
    .sticky-disclosure{grid-column:1/-1;margin:0;color:#5b6770;font-size:10px;line-height:1.35}
    .sticky-disclosure a{color:var(--et-blue-ink);font-weight:800}
    .review-mobile-sticky :focus-visible{outline:3px solid var(--et-orange);outline-offset:2px}
  }
</style>
