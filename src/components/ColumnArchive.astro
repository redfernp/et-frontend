---
import { archivePagePath, type ColumnEntry } from '../lib/column-archives';
type Props = {
  slug: string;
  title: string;
  subtitle: string;
  columnist: string;
  portrait: string;
  intro: string;
  discipline: string;
  accent: string;
  entries: ColumnEntry[];
  page: number;
  totalPages: number;
  siblingLabel: string;
  siblingHref: string;
};
const { slug, title, subtitle, columnist, portrait, intro, discipline, accent, entries, page, totalPages, siblingLabel, siblingHref } = Astro.props;
const latest = page === 1 ? entries[0] : undefined;
const previous = page === 1 ? entries.slice(1) : entries;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---
<article class="column-archive" style={`--column-accent:${accent}`}>
  <nav class="column-breadcrumb" aria-label="Breadcrumb"><a href="/pilot/home/">EveryTip</a><span aria-hidden="true">›</span><a href="/pilot/free-betting-tips/">Free tips</a><span aria-hidden="true">›</span><span>{columnist}</span></nav>
  <header class="column-hero">
    <p class="kicker">{discipline} · weekly column</p>
    <h1>{title}</h1>
    <div class="column-identity"><img src={portrait} alt="" width="100" height="100" /><div><h2>{subtitle}</h2><p>By {columnist} · EveryTip feature columnist</p></div></div>
  </header>
  <div class="column-intro"><p>{intro}</p><p class="column-snapshot">Archive design preview. The post list below is a snapshot of published WordPress articles, not a live feed yet.</p></div>
  <nav class="column-jump" aria-label="Column navigation">{latest && <a href="#latest">Latest preview</a>}<a href="#previous">{page === 1 ? 'Previous previews' : `Archive page ${page}`}</a><a href={siblingHref}>{siblingLabel}</a></nav>

  {latest && <section id="latest" class="column-latest" aria-labelledby="column-latest-heading">
    <div class="column-section-heading"><p class="kicker">Fresh from {columnist}</p><h2 id="column-latest-heading">Latest preview</h2></div>
    <article class="column-feature"><div class="column-feature-copy"><span class="column-date">{latest.dateLabel}</span><h3><a href={latest.href}>{latest.title}</a></h3><p>{latest.excerpt}</p><a class="column-read" href={latest.href}>Read the preview <span aria-hidden="true">→</span></a></div><div class="column-feature-side"><img src={portrait} alt="" width="100" height="100" /><span>{columnist}</span><small>{discipline} analysis</small></div></article>
  </section>}

  <section id="previous" class="column-previous" aria-labelledby="column-previous-heading"><div class="column-section-heading"><p class="kicker">The archive</p><h2 id="column-previous-heading">{page === 1 ? 'Previous previews' : `Previous previews — page ${page}`}</h2><p>Browse the weekly analysis in date order. Page {page} of {totalPages} in this preview.</p></div>
    <div class="column-list">{previous.map((entry) => <article class="column-entry"><div><span class="column-date">{entry.dateLabel}</span>{entry.tag && <span class="column-tag">{entry.tag}</span>}</div><h3><a href={entry.href}>{entry.title}</a></h3><p>{entry.excerpt}</p><a class="column-entry-link" href={entry.href}>Read more <span aria-hidden="true">→</span></a></article>)}</div>
    <nav class="column-pagination" aria-label={`${columnist} archive pages`}>
      {page > 1 ? <a class="column-page-direction" href={archivePagePath(slug, page - 1)} rel="prev">← Newer</a> : <span class="column-page-spacer" aria-hidden="true"></span>}
      <span class="column-page-numbers">{pageNumbers.map((number) => number === page ? <span class="column-page-current" aria-current="page">{number}</span> : <a href={archivePagePath(slug, number)} aria-label={`Page ${number}`}>{number}</a>)}</span>
      {page < totalPages ? <a class="column-page-direction" href={archivePagePath(slug, page + 1)} rel="next">Older →</a> : <span class="column-page-spacer" aria-hidden="true"></span>}
    </nav>
  </section>
  <footer class="column-footer"><p><strong>About this column.</strong> The introduction and columnist biography stay editable in WordPress. The archive entries will come from the relevant published posts through WPGraphQL; Eric will not need to manually paste links each week.</p><p>18+ · Gamble responsibly. No offer link is active in this template preview.</p></footer>
</article>
