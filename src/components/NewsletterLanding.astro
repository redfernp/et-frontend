---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { NavigationItem } from '../lib/menu-tree';

const { variant = 'primary', exactRecord, menuItems, verifiedPublicPaths } = Astro.props as {
  variant?: 'primary' | 'extended';
  exactRecord?: { databaseId: number; seo?: { title?: string; metaDesc?: string } };
  menuItems?: NavigationItem[];
  verifiedPublicPaths?: string[];
};
const extended = variant === 'extended';
const title = extended ? 'Free betting tips, previews and analysis by email' : 'EveryTip daily newsletter';
const benefits = [
  { icon: '01', title: 'Free tips worth reading', copy: 'Horse racing and football coverage, with links back to the full analysis.' },
  { icon: '02', title: 'Timely offer stories', copy: 'Original hooks around big fixtures and festivals, with clear affiliate disclosure and checked terms.' },
  { icon: '03', title: 'Choose what interests you', copy: 'Sport and offer preferences can be captured as the email platform and tracking work matures.' },
];
---
<BaseLayout title={`${title} — newsletter pilot`} wide={true} publicPage={!!exactRecord} previewOnly={!!exactRecord} menuItems={menuItems} verifiedPublicPaths={verifiedPublicPaths} seo={exactRecord ? { title: exactRecord.seo?.title, description: exactRecord.seo?.metaDesc } : undefined} previewMessage={exactRecord ? 'Exact newsletter landing preview · old frequency claims and forms withheld · not for publication' : undefined}>
  <article class="newsletter-landing">
    <nav class="nl-breadcrumb" aria-label="Breadcrumb"><a href={exactRecord ? '/' : '/pilot/home/'}>EveryTip</a><span aria-hidden="true">›</span><span>Newsletter</span></nav>
    <div class="nl-hero"><div class="nl-hero-copy"><p class="kicker">EveryTip email · design pilot</p><h1>{title}</h1><p>{extended ? 'A fuller explanation of the email service for readers who want to know what they will receive before signing up.' : 'Useful racing and football tips, original offer stories and the week’s best previews in your inbox.'}</p><div class="nl-points"><span>Free to join</span><span>Clear preferences</span><span>Unsubscribe anytime</span></div></div><aside class="nl-form-slot"><p class="kicker">Join the list</p><h2>Get EveryTip by email</h2><p>ConvertBox form placement. The existing capture tool remains in place while the email platform migration is planned.</p><div aria-label="Newsletter form design placeholder">Email capture preview</div><small>No form is active in this local template.</small></aside></div>
    <div class="nl-caution"><strong>Subscription promise pending review</strong><p>{exactRecord ? 'The legacy email frequency and provider details are not carried into this preview. Before publication, confirm the real frequency, content types, consent wording, privacy link and SendFox/ConvertBox data flow.' : 'The older page describes 4–6 daily emails and links to AWeber. That copy should not be carried over automatically. Before publication, approve the real frequency, content types, consent wording, privacy link and SendFox/ConvertBox data flow.'}</p></div>
    <section class="nl-benefits"><div class="nl-section-head"><p class="kicker">Why join</p><h2>More than the same offer every week</h2><p>Newsletter readers should have a reason to open each edition. The design makes editorial tips and timely, clearly labelled commercial stories distinct.</p></div><div class="nl-benefit-grid">{benefits.map((benefit) => <article><span>{benefit.icon}</span><h3>{benefit.title}</h3><p>{benefit.copy}</p></article>)}</div></section>
    <section class="nl-example"><div><p class="kicker">A sample edition</p><h2>A better email mix</h2><p>Lead with a useful fixture or race insight. Follow with the relevant story, then show an eligible offer only if the centrally approved record is active for that reader’s location and status.</p></div><div class="nl-email-card"><span>Editorial preview</span><strong>Weekend football story</strong><p>Context and insight first</p><hr /><span>#Ad · relevant offer story</span><strong>One checked offer, if eligible</strong><p>Terms linked from the central record</p></div></section>
    {extended && <section class="nl-detail"><div class="nl-section-head"><p class="kicker">What to expect</p><h2>Tips, previews and analysis</h2></div><p>Eric can edit this long-form explanation in WordPress. It should say which sports are covered, how frequently messages are sent and whether emails include affiliate promotions—using the actual current programme rather than the legacy provider wording.</p><p>Preference tags and click-triggered sequences belong to the separate email/tracking system. This page only explains the promise and hosts the opt-in placement; it should not expose private user data in the frontend.</p></section>}
    <section class="nl-privacy"><h2>Trust and control</h2><div><p><strong>Consent.</strong> The final form must describe what the reader subscribes to and link to the current privacy policy.</p><p><strong>Preferences.</strong> A reader should be able to change sport interests or leave the list without being sent through an unrelated promotion.</p><p><strong>18+ only.</strong> Betting content is for adults. Gamble responsibly.</p></div></section>
    <footer class="nl-footer"><a href={exactRecord ? '/free-betting-tips' : '/pilot/free-betting-tips/'}>Browse free tips before subscribing →</a><span>Local template preview · no email submitted or tracked here.</span></footer>
  </article>
</BaseLayout>
<style>
  .newsletter-landing{padding:5px 12px 32px;color:#263b4e}.nl-breadcrumb{display:flex;gap:8px;color:#647887;font-size:12px;margin-bottom:18px}.nl-hero{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:22px;padding:26px;background:linear-gradient(110deg,#e8f2f9,#f8fbfd);border-top:5px solid var(--et-orange)}.nl-hero h1{max-width:650px;margin:4px 0 13px;font-size:clamp(32px,4vw,47px)}.nl-hero-copy>p:not(.kicker){max-width:640px;font-size:18px}.nl-points{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.nl-points span{padding:7px 10px;background:#fff;color:#345f80;font-size:11px;font-weight:800}.nl-form-slot{padding:22px;background:#fff;box-shadow:0 4px 14px #1640591a;border-top:4px solid var(--et-blue)}.nl-form-slot h2{margin:2px 0 8px;font-size:23px}.nl-form-slot p:not(.kicker){font-size:13px;color:#5b7181}.nl-form-slot>div{margin:17px 0 10px;padding:14px;background:var(--et-newsletter);border-radius:25px;color:#fff;text-align:center;font-size:13px;font-weight:800}.nl-form-slot small{display:block;text-align:center;color:#6b7d89}.nl-caution{margin:17px 0;padding:15px 19px;background:#fff3e7;border-left:4px solid var(--et-orange);font-size:12px}.nl-caution p{margin:4px 0 0}.nl-benefits,.nl-example,.nl-detail,.nl-privacy{margin-top:40px}.nl-section-head .kicker{margin:0}.nl-section-head h2,.nl-example h2,.nl-privacy h2{margin:3px 0 10px;font-size:29px}.nl-section-head>p:last-child{max-width:740px;color:#607485}.nl-benefit-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}.nl-benefit-grid article{padding:18px;background:#f0f6fa;border-top:4px solid var(--et-blue)}.nl-benefit-grid span{color:#ae4e00;font-size:12px;font-weight:900}.nl-benefit-grid h3{margin:8px 0;font-size:18px}.nl-benefit-grid p{margin:0;font-size:13px}.nl-example{display:grid;grid-template-columns:1fr 280px;gap:25px;padding:25px;background:#e9f3f9}.nl-example>div:first-child p:last-child{max-width:650px}.nl-email-card{padding:18px;background:#fff;box-shadow:0 3px 12px #123d5619}.nl-email-card span{color:#a34a00;text-transform:uppercase;font-size:10px;font-weight:900}.nl-email-card strong{display:block;margin:4px 0;color:#1d5077}.nl-email-card p{font-size:12px;margin:4px 0}.nl-email-card hr{border:0;border-top:1px solid #dce7ee;margin:13px 0}.nl-detail p{max-width:840px}.nl-privacy{padding:22px;border:1px solid #d7e5ed}.nl-privacy h2{margin-top:0}.nl-privacy>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.nl-privacy p{margin:0;font-size:13px}.nl-footer{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-top:35px;border-top:1px solid #dce7ed;padding-top:15px;font-size:12px}.nl-footer a{font-weight:800}.nl-footer span{color:#6a7c89}@media(max-width:850px){.nl-hero{grid-template-columns:1fr}.nl-form-slot{max-width:500px}.nl-example{grid-template-columns:1fr}.nl-privacy>div{grid-template-columns:1fr}}@media(max-width:630px){.newsletter-landing{padding:0 0 25px}.nl-hero{padding:18px 15px}.nl-hero-copy>p:not(.kicker){font-size:16px}.nl-benefit-grid{grid-template-columns:1fr}.nl-section-head h2,.nl-example h2,.nl-privacy h2{font-size:24px}.nl-example{padding:17px}}
</style>
