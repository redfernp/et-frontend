---
interface Props {
  profile: { name: string; role: string; bio: string; image: string; slug: string };
  variant: 'byline' | 'full';
  archiveHref?: string;
}
const { profile, variant, archiveHref } = Astro.props;
const archive = archiveHref ?? (profile.slug === 'seymourb' ? '/pilot/saturday-horse-racing-tips/' : '/pilot/english-premier-league-predictions-for-saturday/');
---
{variant === 'byline' ? <div class="columnist-byline" aria-label={`Article by ${profile.name}`}>
  <img src={profile.image} alt={profile.name} width="300" height="300" loading="eager" />
  <div><span class="byline-eyebrow">EveryTip columnist</span><strong>By {profile.name}</strong><span>{profile.role}</span></div>
</div> : <aside class="columnist-card" aria-label={`About ${profile.name}`}>
  <div class="card-image"><img src={profile.image} alt={profile.name} width="300" height="300" loading="lazy" /></div>
  <div class="card-copy"><p class="card-kicker">Meet the writer</p><h2>About {profile.name}</h2><p class="card-role">{profile.role}</p><p class="card-bio">{profile.bio}</p><a href={archive}>More from {profile.name} <span aria-hidden="true">→</span></a></div>
</aside>}
<style>
  .columnist-byline{display:flex;align-items:center;gap:13px;max-width:510px;margin:16px 0 24px;padding:11px 15px 11px 11px;border:1px solid #dce8ef;border-left:4px solid var(--et-orange);border-radius:10px;background:#f7fbfd}
  .columnist-byline img{width:70px;height:70px;flex:none;object-fit:cover;object-position:center 27%;border-radius:9px;background:#e2eaf0}
  .columnist-byline>div{display:grid;gap:1px;line-height:1.3}
  .columnist-byline strong{font-size:16px;color:#183f5f}
  .columnist-byline span{font-size:12px;color:#5d7180}
  .columnist-byline .byline-eyebrow{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#a84c00}
  .columnist-card{display:grid;grid-template-columns:135px minmax(0,1fr);gap:22px;align-items:start;margin:38px 0 10px;padding:23px;border:1px solid #d8e5ee;border-top:5px solid var(--et-orange);border-radius:12px;background:linear-gradient(112deg,#f0f7fb,#fff 55%);box-shadow:0 6px 24px #183f5f0c}
  .card-image img{display:block;width:135px;height:135px;object-fit:cover;object-position:center 27%;border-radius:11px;border:4px solid white;box-shadow:0 3px 14px #183f5f20}
  .card-kicker{margin:0 0 2px;font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#a84c00}
  .card-copy h2{margin:0;color:#183f5f;font-size:23px}
  .card-role{margin:1px 0 9px;font-size:12px;font-weight:800;color:#4d6d82}
  .card-bio{margin:0 0 12px;font-size:14px;line-height:1.65;color:#344b5a}
  .card-copy a{font-size:13px;font-weight:800;text-decoration:none;color:var(--et-blue-ink)}
  .card-copy a:hover{text-decoration:underline}
  .card-copy a:focus-visible{outline:3px solid var(--et-orange);outline-offset:3px}
  @media(max-width:520px){.columnist-card{grid-template-columns:1fr;gap:12px;padding:16px}.card-image img{width:100px;height:100px}.card-copy h2{font-size:19px}.card-bio{font-size:13px}.columnist-byline img{width:58px;height:58px}}
</style>
