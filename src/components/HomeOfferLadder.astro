---
import { featuredOfferPreview } from '../lib/pilot-data';
import { capturedOfferPreview } from '../lib/offer-preview-capture.mjs';

const { heading = "Today's top offers", description = 'Partner welcome offers and rewards · 18+ · T&Cs apply', expanded = false } = Astro.props;
const capture = await capturedOfferPreview();
const displayOffers = featuredOfferPreview.map((offer) => ({ ...offer,
  headline: capture?.offers[offer.id]?.headline ?? offer.headline,
  compactTerms: capture?.offers[offer.id]?.compactTerms ?? null,
}));
const primaryOffers = expanded ? displayOffers : displayOffers.slice(0, 5);
const additionalOffers = expanded ? [] : displayOffers.slice(5);
---
<section class="home-ladder" aria-labelledby="home-offers-heading">
  <div class="home-ladder-heading">
    <div>
      <h2 id="home-offers-heading">{heading}</h2>
      <p>{description}</p>
    </div>
    <span class="home-ladder-badge">{expanded ? '7 previews' : 'Top 5'}</span>
  </div>
  <ol class="home-ladder-list">
    {primaryOffers.map((offer, index) => <li class="home-ladder-row" style={`--ladder-brand:${offer.brandColor}`}>
      <span class="home-ladder-rank">{index + 1}</span>
      <span class:list={['home-ladder-logo', { 'logo-on-light': offer.logoOnLight }]}><img src={offer.logoUrl} alt={offer.bookmaker} loading={index < 2 ? 'eager' : 'lazy'} /></span>
      <div class="home-ladder-copy">
        <h3>{offer.headline}</h3>
        <p>{offer.compactTerms ?? '#Ad · 18+ · This is a visual preview. Approved short terms will be supplied by the central ACF offer record.'}</p>
      </div>
      <span class="home-ladder-cta" aria-label="Offer link disabled in template preview">Offer preview</span>
    </li>)}
  </ol>
  {!expanded && <details class="home-ladder-more">
    <summary><span class="show-more">View all seven offers</span><span class="show-less">Show top five only</span></summary>
    <ol class="home-ladder-list" start="6">
      {additionalOffers.map((offer, index) => <li class="home-ladder-row" style={`--ladder-brand:${offer.brandColor}`}>
        <span class="home-ladder-rank">{index + 6}</span>
        <span class:list={['home-ladder-logo', { 'logo-on-light': offer.logoOnLight }]}><img src={offer.logoUrl} alt={offer.bookmaker} loading="lazy" /></span>
        <div class="home-ladder-copy">
          <h3>{offer.headline}</h3>
          <p>{offer.compactTerms ?? '#Ad · 18+ · This is a visual preview. Approved short terms will be supplied by the central ACF offer record.'}</p>
        </div>
        <span class="home-ladder-cta" aria-label="Offer link disabled in template preview">Offer preview</span>
      </li>)}
    </ol>
  </details>}
  <p class="home-ladder-foot">Please gamble responsibly · 18+ · No affiliate links are active in this preview.{capture && ` ACF draft copy ${capture.sourceMode === 'fresh-staging-wpgraphql-preview' ? 'read from staging WPGraphQL' : 'captured'} ${capture.capturedAt.slice(0, 10)}; current eligibility and full terms still require verification.`}</p>
</section>
