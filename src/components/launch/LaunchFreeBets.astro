---
// Live free bets hub: the approved design with the live offer ladder and the staging guide copy.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeOfferLadder from '../HomeOfferLadder.astro';
import { launchHtml } from '../../lib/builder-cleanup.mjs';
import { endpoint } from '../../lib/launch-content.mjs';
import { contentBeforeHeading } from '../../lib/launch-templates.mjs';

const { record, paths, offers, seo } = Astro.props;
const available = new Set(paths);
// The ladder replaces the page's trailing "Current bookmaker offers" list.
const guide = launchHtml(contentBeforeHeading(record.content, /^Current bookmaker offers/i), endpoint);
const explainer = [
  { title: 'Check who qualifies', text: 'See whether the offer is for new or existing customers, and whether location or payment-method restrictions apply.' },
  { title: 'Read the qualifying action', text: 'Note the deposit, first-bet amount, minimum odds, opt-in and settlement conditions before you sign up.' },
  { title: 'Check the reward', text: 'Look at the free-bet split, expiry, any wagering requirements and withdrawal conditions.' },
];
---
<BaseLayout title={record.title} wide={true} publicPage={true} seo={seo} verifiedPublicPaths={paths} offers={offers}>
  <article class="freebets-guide">
    <nav class="freebets-breadcrumb" aria-label="Breadcrumb"><a href="/">EveryTip</a><span aria-hidden="true">›</span><span>Free bets</span></nav>
    <header class="freebets-hero"><p class="kicker">Free bets</p><h1>Bookmaker free bets &amp; bonus offers</h1><p>Compare offers at a glance, then check the conditions that matter before deciding whether one is right for you.</p><span>18+ · Terms and eligibility vary · T&amp;Cs apply</span></header>
    <div class="freebets-disclosure"><strong>#Ad · How this page earns money</strong><p>EveryTip may receive a commission if you sign up through one of the links on this page. This never changes the terms you get from the bookmaker.</p></div>
    <nav class="freebets-jump" aria-label="On this page"><a href="#compare">Compare offers</a><a href="#understand">How to compare</a><a href="#guide">Free bets guide</a><a href="#questions">Questions</a></nav>

    <section id="compare" class="freebets-offers"><div class="freebets-section-head"><p class="kicker">Today’s offers</p><h2>Offer comparison</h2></div><HomeOfferLadder heading="Compare bookmaker offers" description="New customer offers · 18+ · T&Cs apply" expanded={true} offers={offers} /></section>

    <section id="understand" class="freebets-understand"><div class="freebets-section-head"><p class="kicker">Read before clicking</p><h2>How to compare a free-bet offer</h2></div><div class="freebets-explainer">{explainer.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>

    <section id="guide" class="freebets-source cms-content" aria-label="Free bets guide"><div set:html={guide} /></section>

    <section id="questions" class="freebets-faq"><div class="freebets-section-head"><p class="kicker">Questions</p><h2>Free-bet basics</h2></div>
      <details><summary>Are all these offers for new customers?</summary><p>The offers above are welcome offers for new customers. Each card shows the key terms, and the full terms are on the bookmaker’s site.</p></details>
      <details><summary>Will I get the free bet immediately?</summary><p>That depends on the offer. Check the qualifying bet, settlement, opt-in and crediting rules in its terms.</p></details>
      {available.has('/latest-betting-offers') && <details><summary>Where can I see other promotions?</summary><p>See our <a href="/latest-betting-offers">latest betting offers</a> for existing-customer and event promotions.</p></details>}
    </section>
    <footer class="freebets-footer">18+ · Please gamble responsibly · <a href="https://www.begambleaware.org/" rel="noopener">BeGambleAware.org</a></footer>
  </article>
</BaseLayout>
<style>
  .freebets-guide{padding:5px 14px 35px;color:#263748}.freebets-breadcrumb{display:flex;gap:9px;color:#677888;font-size:12px;margin:0 0 20px}.freebets-hero{padding:28px 30px;background:linear-gradient(110deg,#e8f2f8,#f9fbfc);border-top:5px solid var(--et-orange)}.freebets-hero h1{max-width:800px;margin:3px 0 12px}.freebets-hero>p:not(.kicker){max-width:760px;font-size:17px}.freebets-hero span{font-size:12px;font-weight:800;color:#536d7f}.freebets-disclosure{margin:17px 0;padding:16px 19px;background:#fff4e9;border-left:4px solid var(--et-orange);font-size:13px}.freebets-disclosure p{margin:5px 0 0}.freebets-jump{display:flex;flex-wrap:wrap;gap:9px;padding:8px 0 21px;border-bottom:1px solid #dce5ec}.freebets-jump a{padding:8px 13px;background:#e7f1f8;color:#1d5c8d;font-size:13px;font-weight:800;text-decoration:none}.freebets-section-head{margin:0 0 19px}.freebets-section-head .kicker{margin-bottom:4px}.freebets-section-head h2,.freebets-terms h2{margin:0 0 8px;font-size:29px}.freebets-section-head p:last-child{margin:0;color:#607280}.freebets-offers,.freebets-understand,.freebets-terms,.freebets-faq,.freebets-source{margin-top:39px;scroll-margin-top:22px}.freebets-source{max-width:900px;overflow-wrap:anywhere;line-height:1.7}.freebets-source :global(h2){margin-top:35px}.freebets-source :global(h3){margin-top:23px}.freebets-offers .home-ladder{max-width:none}.freebets-explainer{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.freebets-explainer article{padding:20px;background:#f1f6fa;border-top:4px solid var(--et-blue)}.freebets-explainer span{color:#b45608;font-size:12px;font-weight:900}.freebets-explainer h3{margin:5px 0 8px;font-size:18px}.freebets-explainer p{margin:0;font-size:13px}.freebets-terms{display:grid;grid-template-columns:1.2fr .8fr;gap:25px;padding:25px;background:#edf4f8}.freebets-terms>div:first-child p:last-child{max-width:650px}.freebets-terms-demo{padding:18px;background:white;border-left:4px solid var(--et-orange)}.freebets-terms-demo ol{padding-left:20px;font-size:13px}.freebets-terms-demo span{font-size:12px;color:#607282}.freebets-faq details{border-bottom:1px solid #dce5ec;padding:12px 0}.freebets-faq summary{cursor:pointer;color:#1c598f;font-weight:800}.freebets-faq details p{max-width:850px}.freebets-footer{margin-top:40px;padding-top:15px;border-top:1px solid #dce5ec;color:#607280;font-size:12px}@media(max-width:750px){.freebets-explainer{grid-template-columns:1fr}.freebets-terms{grid-template-columns:1fr}}@media(max-width:600px){.freebets-guide{padding:0 0 25px}.freebets-hero{padding:20px 17px}.freebets-hero>p:not(.kicker){font-size:15px}.freebets-section-head h2,.freebets-terms h2{font-size:24px}.freebets-terms{padding:17px}.freebets-jump a{font-size:12px}}
  .cms-content :global(img){max-width:100%;height:auto}
  .cms-content :global(table){display:block;max-width:100%;overflow-x:auto}
</style>
