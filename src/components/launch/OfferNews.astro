---
// "Latest Betting Offer News": the newest Offer News posts, styled like the live list
// (date, title, one-line summary). Used on the homepage and the free tips page.
interface Props { items: { uri: string; title: string; date: string; summary?: string }[] }
const { items } = Astro.props;
const formatDate = (value: string) => new Date(`${value}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---
{items.length > 0 && <section class="offer-news" aria-labelledby="offer-news-title">
  <p class="kicker">Latest from EveryTip</p>
  <h2 id="offer-news-title">Latest Betting Offer News</h2>
  <ul>
    {items.map((item) => <li>
      <a href={item.uri}><time datetime={item.date}>{formatDate(item.date)}</time><span>{item.title}</span></a>
      {item.summary && <p>{item.summary}</p>}
    </li>)}
  </ul>
</section>}

<style>
  .offer-news { margin: 36px auto 0; }
  .offer-news h2 { margin: 0 0 12px; font-size: clamp(22px, 2.6vw, 28px); color: #183f60; }
  .offer-news ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 28px; margin: 0; padding: 4px 22px; list-style: none; border: 1px solid #e0e6ea; border-left: 4px solid var(--et-orange); border-radius: 6px; background: #fff; }
  .offer-news li { padding: 14px 0; border-top: 1px solid #eef1f4; }
  /* No divider above the first row (first item in each column). */
  .offer-news li:nth-child(-n + 2) { border-top: 0; }
  .offer-news a { display: block; color: #183f60; text-decoration: none; }
  .offer-news time { display: block; margin-bottom: 3px; color: var(--et-orange-ink); font-size: 11px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; }
  .offer-news a span { display: block; font-size: 17px; font-weight: 800; line-height: 1.3; }
  .offer-news a:hover span { text-decoration: underline; text-decoration-color: #f7941d; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .offer-news p { margin: 5px 0 0; color: #556574; font-size: 14px; line-height: 1.45; }
  @media (max-width: 700px) { .offer-news ul { grid-template-columns: 1fr; } .offer-news li:nth-child(2) { border-top: 1px solid #eef1f4; } }
</style>
