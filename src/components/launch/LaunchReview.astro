---
// Live bookmaker review in the approved Bet365 review design, built from the page's headings.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewMobileSticky from '../ReviewMobileSticky.astro';
import { splitReview, reviewOwnOffer } from '../../lib/review-sections.mjs';
import { plainTitle } from '../../lib/launch-templates.mjs';
import { exPartnerFor } from '../../lib/ranked-cards.mjs';

const { record, body, paths, offers, seo, bookmaker } = Astro.props;
const review = splitReview(body);
// The bookmaker's offer from the offers file, otherwise the review's own #Ad copy.
const fileOffer = offers.find((offer) => offer.id === bookmaker.partner);
const own = reviewOwnOffer(body, bookmaker.name);
// Former partners keep their review but get no offer card, claim section or sticky bar.
const exPartner = exPartnerFor(bookmaker.name);
const offer = exPartner ? null : fileOffer ? { headline: fileOffer.headline, terms: fileOffer.compactTerms, link: fileOffer.ctaPath, label: fileOffer.ctaLabel, logo: fileOffer.logoUrl, color: fileOffer.brandColor }
  : own.link ? { headline: own.headline ? own.headline.charAt(0).toUpperCase() + own.headline.slice(1) : `Join ${bookmaker.name}`, terms: own.terms, link: own.link, label: 'Claim offer', logo: null, color: '#1d5b32' } : null;
const byline = /seymour biz/i.test(plainTitle(review.introHtml).slice(0, 600)) || /seymour/i.test(review.headline ?? '')
  ? { name: 'Seymour Biz', role: 'EveryTip horse racing columnist', image: 'https://www.everytip.co.uk/wp-content/uploads/2025/06/Seymour-Biz-Horse-Racing-Feature-Writer-100x100.png' }
  : { name: 'the EveryTip team', role: 'Independent bookmaker review', image: 'https://www.everytip.co.uk/wp-content/uploads/2025/06/cropped-ET.jpg' };
const title = `${bookmaker.name} Review ${new Date(record.modified).getUTCFullYear()}`;
const updated = new Date(record.modified).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const jump = [
  ...(review.pros || review.cons ? [{ href: '#review-pros-cons', label: 'Pros & cons' }] : []),
  ...(review.sections.length ? [{ href: '#review-assessment', label: 'Full assessment' }] : []),
  ...(review.verdict ? [{ href: '#review-verdict', label: 'Final verdict' }] : []),
];
---
<BaseLayout title={title} publicPage={true} wide={true} seo={seo} verifiedPublicPaths={paths} offers={offers}>
  <article class="review cms-content" style={`--review-green:${offer?.color ?? '#1d5b32'};--review-green-dark:#144324`}>
    <header class="hero">
      <div>
        <p class="eyebrow">Independent bookmaker review</p>
        <h1>{title}</h1>
        {seo.description && <p class="deck">{seo.description}</p>}
        <div class="author"><img src={byline.image} alt="" width="80" height="80" /><div><strong>Reviewed by {byline.name}</strong><span>{byline.role}</span></div></div>
        <p class="dated">Last updated {updated}.</p>
      </div>
      {offer && <aside class="offer" id="review-offer" aria-label={`${bookmaker.name} welcome offer`}>
        {offer.logo ? <div class="offer-logo" style={`background:${offer.color}`}><img src={offer.logo} alt={bookmaker.name} width="150" height="40" /></div> : <p class="offer-name">{bookmaker.name}</p>}
        <p class="offer-label">New customer offer · #Ad</p>
        <h2>{offer.headline}</h2>
        {offer.terms && <p class="offer-terms">{offer.terms}</p>}
        <a class="disabled-cta live-cta" href={offer.link} rel="sponsored nofollow">{offer.label}</a>
      </aside>}
    </header>

    {jump.length > 0 && <nav class="jump" aria-label="In this review"><strong>In this review</strong>{jump.map((item) => <a href={item.href}>{item.label}</a>)}</nav>}
    {review.introHtml && <section class="method" id="review-intro"><div class="editorial" set:html={review.introHtml} /></section>}
    {(review.pros || review.cons) && <section class="pros-cons" id="review-pros-cons">
      {review.pros && <div><p class="eyebrow">From our review</p><h2>{review.pros.title}</h2><div class="editorial" set:html={review.pros.html} /></div>}
      {review.cons && <div><p class="eyebrow">What to weigh up</p><h2>{review.cons.title}</h2><div class="editorial" set:html={review.cons.html} /></div>}
    </section>}
    {review.sections.length > 0 && <section class="assessment" id="review-assessment"><div class="section-intro"><p class="eyebrow">The full editorial assessment</p><h2>Our {bookmaker.name} review in detail</h2></div>
      {review.sections.map((section, index) => <section class="review-section"><div class="section-heading"><span>{String(index + 1).padStart(2, '0')}</span><h3>{section.title.replace(/^\d+\.\s*/, '')}</h3></div><div class="editorial" set:html={section.html} /></section>)}
    </section>}
    {review.verdict && <section class="verdict" id="review-verdict"><p class="eyebrow">Final verdict</p><h2>{review.verdict.title}</h2><div class="editorial" set:html={review.verdict.html} /></section>}
    {!exPartner && review.claimHtml && <section class="other-offers" set:html={review.claimHtml} />}
    {review.otherOffersHtml && <section class="other-offers" set:html={review.otherOffersHtml} />}
    <footer class="disclosure"><p><strong>Affiliate disclosure.</strong> EveryTip may earn a commission from bookmaker links.</p><p><strong>Safer gambling.</strong> 18+ only. Please gamble responsibly. <a href="/safer-gambling">Find support and safer-gambling information</a>.</p></footer>
  </article>
  {offer && <ReviewMobileSticky bookmaker={bookmaker.name} offerHref={offer.link} ctaLabel={offer.label} />}
</BaseLayout>
<style>
  .review{color:#173b58}.review :global(p){line-height:1.7}.hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(270px,.68fr);gap:32px;align-items:start;margin:24px 0 30px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;color:#b74700;font-weight:800;font-size:.78rem;margin:0 0 10px}.hero h1{font-size:clamp(2.4rem,5vw,4.3rem);line-height:1.04;margin:0 0 20px}.deck{font-size:1.18rem;max-width:62ch}.author{display:flex;align-items:center;gap:14px;background:#eef5f8;padding:12px 16px;border-left:4px solid #f36b00;border-radius:8px;max-width:540px}.author img{width:62px;height:62px;object-fit:cover;border-radius:8px}.author strong,.author span{display:block}.author span{font-size:.84rem;color:#42627a}.dated{font-size:.86rem;color:#52697b}.offer{background:#fff;border:1px solid #c8d8e1;border-top:6px solid var(--review-green);border-radius:10px;padding:24px;box-shadow:0 10px 30px #153e5e0e}.offer img{display:block;margin:auto}.offer-label{color:var(--review-green);font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;margin-top:20px}.offer h2{margin:0;font-size:1.6rem}.disabled-cta{display:block;text-align:center;background:#d9e0e5;color:#405868;padding:14px;border-radius:6px;font-weight:800;margin-top:20px}.jump{display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px;padding:17px 22px;background:#eaf2f7;border-radius:8px;margin:24px 0 34px}.jump a{color:#144e7b;font-weight:700}.method,.welcome,.verdict{border-radius:10px;padding:clamp(24px,4vw,42px);margin:26px 0}.method{background:#eff6f8;border-left:5px solid #f36b00}.welcome{background:#fff6eb;border-left:5px solid #f36b00}.verdict{background:#eef5f0;border-left:5px solid var(--review-green)}.method h2,.welcome h2,.verdict h2,.section-intro h2{margin:0 0 14px;font-size:clamp(1.6rem,3vw,2.3rem)}.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:18px}.pros-cons>div{padding:25px;background:#f3f7f9;border:1px solid #ccdde6;border-radius:8px}.pros-cons>div:first-child{border-top:4px solid var(--review-green)}.pros-cons>div:last-child{border-top:4px solid #f36b00}.pros-cons h2{margin:0 0 10px;font-size:1.35rem}.pros-cons :global(ul){margin:0;padding-left:20px}.pros-cons :global(li){margin:0 0 10px;line-height:1.5}.section-intro{margin:45px 0 22px}.review-section{padding:26px 0;border-top:1px solid #cfdee7}.section-heading{display:flex;align-items:flex-start;gap:18px}.section-heading span{background:#174c76;color:#fff;font-weight:800;border-radius:50%;min-width:42px;height:42px;display:grid;place-items:center}.section-heading h3{font-size:1.45rem;margin:5px 0 15px}.editorial{max-width:78ch}.editorial :global(p){margin:0 0 16px}.editorial :global(p:last-child){margin-bottom:0}.disclosure{border-top:1px solid #c6d7e1;padding:20px 0 34px;font-size:.9rem}.disclosure a{color:#144e7b}@media(max-width:760px){.hero,.pros-cons{grid-template-columns:1fr;gap:20px}.offer{padding:20px}.jump{display:grid;gap:8px}.review-section{padding:22px 0}.section-heading{gap:10px}.section-heading h3{font-size:1.2rem}}
  .live-cta{cursor:pointer;text-decoration:none;background:var(--et-commercial);color:#fff}
  .other-offers{margin:36px 0}
  .cms-content :global(.offer-slot){margin:18px 0;padding:18px 20px;border:1px solid #d5e2ea;border-left:5px solid var(--et-orange);background:#fff}
  .cms-content :global(.offer-slot h2){margin:.25rem 0 .6rem;font-size:21px}
  .cms-content :global(.offer-slot p){font-size:13px}
  .cms-content :global(.offer-bookmaker){font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#a74a04;margin:0}
  .cms-content :global(.offer-slot a){display:inline-block;padding:10px 16px;border-radius:4px;background:var(--et-commercial);color:#fff;font-weight:900;text-decoration:none}
  .offer-logo{display:grid;place-items:center;min-height:64px;border-radius:6px;padding:10px}
  .offer-logo img{max-height:48px;width:auto;margin:0}
  .offer-name{font-size:1.4rem;font-weight:900;text-align:center;margin:0}
  .offer-terms{font-size:.8rem;line-height:1.5;color:#52697b}
  .editorial :global(img){max-width:100%;height:auto}
  .editorial :global(table){display:table;width:100%}
  .review-section .editorial :global(h3){font-size:1.15rem;margin:18px 0 8px}
</style>
