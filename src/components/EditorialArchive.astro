---
import BaseLayout from '../layouts/BaseLayout.astro';
import { editorialArchiveEntries, editorialArchivePageCount, editorialArchivePagePath, type EditorialArchiveData } from '../lib/editorial-archives';

const { data, page = 1 } = Astro.props as { data: EditorialArchiveData; page?: number };
const entries = editorialArchiveEntries(data, page);
const total = editorialArchivePageCount(data);
const isAuthor = data.slug.startsWith('author/');
---
<BaseLayout title={`${data.title} — archive pilot`} sidebar={true} robots="noindex,nofollow" relatedTopic={isAuthor ? 'football' : 'racing'}>
  <article class="editorial-archive">
    <nav class="ea-breadcrumb" aria-label="Breadcrumb"><a href="/pilot/home/">EveryTip</a><span aria-hidden="true">›</span><span>{data.category}</span></nav>
    <header class="ea-hero"><p class="kicker">{data.eyebrow} · design pilot</p>{isAuthor && <img class="ea-author-photo" src="https://www.everytip.co.uk/wp-content/uploads/2025/06/John-Newsome-Everytip-Football-Feature-Writer-100x100.png" alt="" width="100" height="100" />}<h1>{data.title}</h1><p>{data.intro}</p><div class="ea-hero-tags"><span>{data.seoPolicy === 'index' ? 'Legacy indexable archive' : 'Legacy noindex archive'}</span><span>Page {page} of {total}</span></div></header>
    <p class="ea-status">Entries below link to other local template previews; they are layout fixtures, not a WordPress query. The production archive will use published post dates, excerpts and featured images from WPGraphQL.</p>
    <div class="ea-tools"><strong>{page === 1 ? 'Browse the archive' : `Older entries · page ${page}`}</strong><span>{data.category} · newest first</span></div>
    <div class="ea-grid">{entries.map((entry, index) => <article class:list={['ea-entry', {'ea-lead': page === 1 && index === 0}]}><div class="ea-entry-image"><span>{entry.category}</span></div><div class="ea-entry-copy"><span class="ea-entry-meta">{entry.date} · {entry.category}</span><h2><a href={entry.href}>{entry.title}</a></h2><p>{entry.excerpt}</p><a class="ea-read" href={entry.href}>Read preview <span aria-hidden="true">→</span></a></div></article>)}</div>
    <nav class="ea-pagination" aria-label={`${data.category} archive pages`}><span>{page > 1 ? <a href={editorialArchivePagePath(data.slug, page - 1)} rel="prev">← Newer</a> : null}</span><div>{Array.from({length:total},(_,i)=>i+1).map((number) => number === page ? <span class="ea-current" aria-current="page">{number}</span> : <a href={editorialArchivePagePath(data.slug, number)} aria-label={`Page ${number}`}>{number}</a>)}</div><span>{page < total ? <a href={editorialArchivePagePath(data.slug, page + 1)} rel="next">Older →</a> : null}</span></nav>
    <footer class="ea-footer">Archive introduction and category metadata remain editable in WordPress. Pagination links must preserve the exact legacy route pattern and SEO policy. This pilot remains noindex, regardless of the eventual live policy.</footer>
  </article>
</BaseLayout>
<style>
  .editorial-archive{color:#283b4a}.ea-breadcrumb{display:flex;gap:8px;color:#6c7d8b;font-size:12px;margin-bottom:18px}.ea-hero{padding:23px;background:linear-gradient(105deg,#e9f3f9,#f9fbfc);border-top:5px solid var(--et-orange)}.ea-author-photo{float:right;width:78px;height:78px;border-radius:50%;object-fit:cover;border:3px solid #fff;box-shadow:0 3px 10px #163f5920}.ea-hero h1{margin:4px 0 11px}.ea-hero>p:not(.kicker){max-width:710px;font-size:15px}.ea-hero-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.ea-hero-tags span{padding:6px 10px;background:white;color:#496b82;font-size:11px;font-weight:800}.ea-status{padding:11px 14px;background:#fff3e9;border-left:3px solid var(--et-orange);font-size:12px}.ea-tools{display:flex;justify-content:space-between;gap:12px;align-items:center;margin:28px 0 14px}.ea-tools strong{color:#1d527b;font-size:18px}.ea-tools span{color:#6c7b86;font-size:11px}.ea-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.ea-entry{display:grid;grid-template-columns:90px minmax(0,1fr);border:1px solid #d9e4eb;min-width:0;overflow:hidden}.ea-entry-image{display:grid;place-items:center;padding:10px;background:linear-gradient(135deg,#216da5,#153f64);color:white;text-align:center}.ea-entry-image span{font-size:12px;font-weight:900;text-transform:uppercase}.ea-entry-copy{padding:16px}.ea-entry-meta{color:#a64e08;font-size:10px;font-weight:800;text-transform:uppercase}.ea-entry h2{margin:7px 0;font-size:18px;line-height:1.24}.ea-entry h2 a{text-decoration:none;color:#1c4d73}.ea-entry h2 a:hover{text-decoration:underline}.ea-entry p{margin:0 0 12px;color:#5d7180;font-size:12px}.ea-read{font-size:12px;font-weight:800;text-decoration:none}.ea-entry.ea-lead{grid-column:1 / -1;grid-template-columns:180px minmax(0,1fr)}.ea-lead .ea-entry-image span{font-size:18px}.ea-lead h2{font-size:24px}.ea-pagination{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:23px;padding:14px 0;border-top:1px solid #dce6eb}.ea-pagination>div{display:flex;gap:5px}.ea-pagination a,.ea-current{display:inline-flex;justify-content:center;align-items:center;min-width:35px;min-height:35px;padding:6px 9px;border:1px solid #c4d8e5;color:#1c5c8d;text-decoration:none;font-size:12px;font-weight:800}.ea-current{background:var(--et-blue);color:white;border-color:var(--et-blue)}.ea-footer{margin-top:25px;border-top:1px solid #dce6eb;padding-top:12px;color:#697b88;font-size:11px}@media(max-width:700px){.ea-grid{grid-template-columns:1fr}.ea-entry.ea-lead{grid-column:auto;grid-template-columns:90px minmax(0,1fr)}.ea-lead h2{font-size:18px}}@media(max-width:460px){.ea-hero{padding:18px 14px}.ea-author-photo{width:56px;height:56px}.ea-tools{display:block}.ea-tools span{display:block;margin-top:3px}.ea-entry,.ea-entry.ea-lead{grid-template-columns:1fr}.ea-entry-image{min-height:62px}.ea-pagination{flex-wrap:wrap}.ea-pagination>span{min-width:65px}}
</style>
