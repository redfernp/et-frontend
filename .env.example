# Copy to .env.local on your own computer. Never commit or paste the real values.
EVERYTIP_WP_BASE_URL=https://wordpress-159231-2098144.cloudwaysapps.com
EVERYTIP_WP_USERNAME=
EVERYTIP_WP_APPLICATION_PASSWORD=
# Local pilot only: opt into fresh, read-only private staging roundup drafts.
# Without this switch the pilots use clearly labelled dated captures.
MIGRATION_STAGING_ROUNDUP_READ=0
# Local pilot only: read one published article directly from staging WPGraphQL.
# A failed opted-in read stops the build instead of using the dated snapshot.
MIGRATION_STAGING_ARTICLE_READ=0
# Refresh the three priority exact pages from staging WPGraphQL during a local
# preview build. This does not approve offers, remove noindex, or deploy.
MIGRATION_STAGING_PRIORITY_READ=0
# Exact local Bet365 review preview only. Opt into a fresh staging WPGraphQL
# page read; the conflicting WordPress SEO and all offer links remain withheld.
MIGRATION_STAGING_BET365_REVIEW_READ=0
# Local read-only inventory probe; never used for public route generation yet.
MIGRATION_STAGING_DISCOVERY=0
# Add only after a clearly labelled staging test offer draft exists.
EVERYTIP_TEST_OFFER_ID=
# Exact local preview only. Reads one unpublished Gutenberg editorial draft;
# leaves the published free-tips page and commercial modules unchanged.
MIGRATION_STAGING_FREE_TIPS_DRAFT_READ=0
# Exact local preview only. Four dated John/Seymour records from live public REST;
# requires safe exact local article assets and does not activate offers or tips.
# Do not combine with the staging home/free-tips feed read flags.
MIGRATION_LIVE_EDITORIAL_FEED_READ=0
